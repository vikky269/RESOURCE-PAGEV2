# Copy to .env for local use. Put real values in Netlify Environment variables
# (Functions scope, or all scopes) for hosted use, then redeploy.

# Server-only catalog writer. Never give this to ChatGPT.
SMARTMATHZ_UPDATE_TOKEN=

# Operator password for ChatGPT OAuth authorize page (>= 16 chars).
SMARTMATHZ_OPERATOR_PASSWORD=

# Seals OAuth authorization codes and access tokens (>= 32 chars).
SMARTMATHZ_OAUTH_JWE_SECRET=

# Public site origin used in OAuth metadata (production: https://resource-page-v2.netlify.app).
SMARTMATHZ_SITE_URL=

# Optional / unused for public page access (legacy).
SMARTMATHZ_VIEWER_PASSWORD=
