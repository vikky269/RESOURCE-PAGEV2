# Copy to .env for local use. Put real values in Netlify Environment variables
# (Functions scope, or all scopes) for hosted use, then redeploy.
# Pages are public. Only the update token is required for catalog writes.
SMARTMATHZ_UPDATE_TOKEN=

# Optional / unused for public access (kept for local compatibility).
SMARTMATHZ_VIEWER_PASSWORD=

# Used only by the update client, not by the website build.
SMARTMATHZ_SITE_URL=
